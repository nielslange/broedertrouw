# ============================================================
# System & editor
# ============================================================
.DS_Store
.idea
.vscode/sftp.json
.valetrc
.env
.env.*
!.env.*.example
.env.local

# ============================================================
# Cache & build artifacts
# ============================================================
.cache/
*.cache
**/*.log
.playwright-mcp/
node_modules/
vendor/

# ============================================================
# WordPress core (managed separately)
# ============================================================
wp-includes/
wp-admin/
/*.php
!/index.php
license.txt
readme.html

# ============================================================
# wp-content: ignore everything, then allowlist what we track
# ============================================================
wp-content/*

# Child theme (our custom code)
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/broedertrouw/
!wp-content/themes/broedertrouw/**

# Premium plugins, uploads, languages etc. stay untracked

# Session build scripts (untracked, see PLAN.md step 0b)
/scripts/
