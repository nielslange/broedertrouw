{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bt/page-header",
	"title": "Page header",
	"description": "Tinted page hero with kicker, title, lead and optional portraits.",
	"category": "broedertrouw",
	"icon": "cover-image",
	"keywords": [ "hero", "header", "title", "intro" ],
	"textdomain": "broedertrouw",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"jsx": false,
		"multiple": false
	},
	"style": [ "file:./style.css" ]
}
