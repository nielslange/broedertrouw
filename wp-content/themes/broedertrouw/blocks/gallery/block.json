{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bt/gallery",
	"title": "Filterable gallery",
	"description": "Masonry photo gallery with category filter chips.",
	"category": "broedertrouw",
	"icon": "format-gallery",
	"keywords": [ "gallery", "photos", "images", "filter" ],
	"textdomain": "broedertrouw",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"jsx": false
	},
	"style": [ "file:./style.css" ],
	"viewScript": [ "file:./script.js" ]
}
