# Local development environment.
# Copy to .env.local and fill in. .env.local is gitignored — never commit real credentials.

# Site under test
LOCAL_URL=https://broedertrouw.test

# WordPress admin login, used for browser-based inspection of wp-admin (block editor,
# ACF field groups, trip list). WP-CLI does not need these.
WP_ADMIN_USER=
WP_ADMIN_PASS=
